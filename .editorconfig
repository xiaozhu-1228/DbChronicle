root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{cs,csproj,sln,props,targets}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{xml,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.{xml,json,yml,yaml}]
end_of_line = crlf

# 逻辑模型不允许格式化：属性顺序、缩进、尾随空白都参与 checksum
[migrations/**]
end_of_line = lf
trim_trailing_whitespace = false

[Test/samples/migrations/**]
end_of_line = lf
trim_trailing_whitespace = false

[Test/DbChronicle.Demo/LogicModels/**]
end_of_line = lf
trim_trailing_whitespace = false
