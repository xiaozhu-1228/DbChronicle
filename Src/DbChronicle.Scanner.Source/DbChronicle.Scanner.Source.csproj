<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 插件需自带第三方依赖（Roslyn），放进 plugins/ 后能被独立加载 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DbChronicle.Scanner.Source</RootNamespace>
    <AssemblyName>DbChronicle.Scanner.Source</AssemblyName>
    <PackageId>DbChronicle.Scanner.Source</PackageId>
    <Version>1.0.0</Version>
    <Description>DbChronicle 的 C# 源码扫描器（Roslyn）：从源码直接生成基线草案，无需先编译</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbChronicle\DbChronicle.csproj" />
    <!-- 插件契约（IPluginRegistry / ISourceScanner）来自 CLI 程序集；Private=false 不复制宿主 dll -->
    <ProjectReference Include="..\DbChronicle.Cli\DbChronicle.Cli.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn 只属于源码扫描器，核心库保持零第三方依赖 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

</Project>
