<?xml version="1.0" encoding="utf-8"?>
<!--
  IDE 模板：复制到 migrations/ 后必须重命名为
  {yyyyMMdd_HHmmss}_{6位随机码}_{语义描述}.xml，并把 id 改为同名前缀。
  推荐直接用 `db-chronicle new --desc "..."` 生成，避免手填错误。
-->
<changeUnit id="REPLACE_WITH_FILE_NAME_PREFIX" author="REPLACE_WITH_AUTHOR" release="REPLACE_WITH_yyyyMMdd">
  <description>REPLACE_WITH_DESCRIPTION</description>

  <!-- 可选：显式声明依赖的原变更单元 -->
  <!-- <depends on="20261021_100000_a1b2c3"/> -->

  <table name="REPLACE_WITH_TABLE" action="ALTER">
    <!-- 增量模式（默认）：只写变化项，其余属性由累积模型补全 -->
    <column name="REPLACE_WITH_COLUMN" action="MODIFY" length="128"/>

    <!-- 新增列 -->
    <!-- <column name="new_column" action="ADD" type="String" length="64" nullable="true" comment="说明"/> -->

    <!-- 删除列需要 options.allowDestructive: true -->
    <!-- <column name="old_column" action="DROP"/> -->
  </table>
</changeUnit>
