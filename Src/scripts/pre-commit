#!/bin/sh
# 安装：cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -e

CONFIG="${1:-dbchronicle.config.yaml}"
if [ ! -f "$CONFIG" ]; then
    echo "db-chronicle: 未找到 $CONFIG，跳过校验"
    exit 0
fi

if ! command -v db-chronicle >/dev/null 2>&1; then
    echo "db-chronicle: 未安装 CLI（dotnet tool install -g DbChronicle.Cli），跳过硬校验"
    exit 0
fi

echo "db-chronicle: 校验变更单元..."
db-chronicle check --config "$CONFIG"
