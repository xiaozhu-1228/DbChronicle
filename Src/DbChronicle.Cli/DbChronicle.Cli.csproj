<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DbChronicle.Cli</RootNamespace>
    <AssemblyName>db-chronicle</AssemblyName>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>db-chronicle</ToolCommandName>
    <PackageId>DbChronicle.Cli</PackageId>
    <Version>1.0.0</Version>
    <Description>数据库版本托管与升级工具集</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbChronicle\DbChronicle.csproj" />
    <!-- 数据库驱动在独立执行器库，核心库保持零第三方依赖；CLI 只是它的一个消费者 -->
    <ProjectReference Include="..\DbChronicle.Executor.AdoNet\DbChronicle.Executor.AdoNet.csproj" />
    <!-- Roslyn 源码扫描（scan 命令的 source 参数）按需引用 -->
    <ProjectReference Include="..\DbChronicle.Scanner.Source\DbChronicle.Scanner.Source.csproj" />
    <!-- Java / Go / TypeScript 源码扫描 -->
    <ProjectReference Include="..\DbChronicle.Scanner.Languages\DbChronicle.Scanner.Languages.csproj" />
  </ItemGroup>

</Project>
