<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 插件需自带依赖，放进 plugins/ 后能被独立加载 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DbChronicle.Scanner.Languages</RootNamespace>
    <AssemblyName>DbChronicle.Scanner.Languages</AssemblyName>
    <PackageId>DbChronicle.Scanner.Languages</PackageId>
    <Version>1.0.0</Version>
    <Description>DbChronicle 的多语言实体扫描器（Java / Go / TypeScript）：轻量源码解析，零第三方依赖</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbChronicle\DbChronicle.csproj" />
    <!-- 插件契约（IPluginRegistry / ISourceScanner）来自 CLI 程序集；Private=false 不复制宿主 dll -->
    <ProjectReference Include="..\DbChronicle.Cli\DbChronicle.Cli.csproj" Private="false" />
  </ItemGroup>

</Project>
