<?xml version="1.0" encoding="utf-8"?>
<changeUnit id="20261028_120107_c06006" author="ops-test" release="20261028">
  <description>第 6 类 约束操作：唯一 ADD/DROP（唯一索引）/ 检查 ADD + DROP / 默认值 ADD+DROP（rebuild）</description>

  <table name="dcops_t06_uk" action="ALTER">
    <uniqueConstraint name="uk_t06_new" action="ADD" columns="code,age"/>
    <uniqueConstraint name="uk_t06_legacy" action="DROP"/>
  </table>

  <table name="dcops_t06_ck" action="ALTER">
    <checkConstraint name="ck_t06_age" action="ADD" expression="age IS NULL OR (age &gt;= 0 AND age &lt;= 150)"/>
  </table>

  <table name="dcops_t06_ck_drop" action="ALTER">
    <checkConstraint name="ck_t06_legacy" action="DROP"/>
  </table>

  <table name="dcops_t06_df" action="ALTER">
    <defaultConstraint name="df_t06_new" action="ADD" column="status" value="0"/>
    <defaultConstraint name="df_t06_legacy" action="DROP" column="legacy_status"/>
  </table>
</changeUnit>
