<changeUnit id="20261028_100104_a04004" author="ops-test" release="20261028">
  <description>第 4 类 索引操作：普通 4.1 / 唯一 4.2 / 复合 4.3 / DROP 4.4 / RENAME 4.5 / 部分 4.7 / 全文 4.8 / 函数 4.6（8.0 专属，放最后）</description>

  <table name="dcops_t04_idx" action="ALTER">
    <index name="idx_t04_normal" action="ADD" columns="a"/>
