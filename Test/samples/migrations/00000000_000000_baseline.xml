<changeUnit id="00000000_000000_baseline" author="scanner" release="00000000">
  <description>基线：示例用户与订单表</description>

  <table name="nor_user" action="CREATE" comment="用户表">
    <column name="id" action="ADD" type="Int64" primaryKey="true" autoIncrement="true" nullable="false"/>
    <column name="username" action="ADD" type="String" length="64" nullable="false" comment="用户名"/>
    <column name="email" action="ADD" type="String" length="128" nullable="true" comment="邮箱"/>
    <column name="status" action="ADD" type="Int32" nullable="false" defaultValue="0"/>
    <column name="created_at" action="ADD" type="DateTime" nullable="false" defaultValue="CURRENT_TIMESTAMP" comment="创建时间"/>
    <index name="idx_user_email" action="ADD" unique="true">
      <columnRef name="email"/>
    </index>
  </table>

  <table name="nor_order" action="CREATE" comment="订单表">
    <column name="id" action="ADD" type="Int64" primaryKey="true" autoIncrement="true" nullable="false"/>
    <column name="user_id" action="ADD" type="Int64" nullable="false"/>
    <column name="amount" action="ADD" type="Decimal" precision="18" scale="2" nullable="false"/>
    <foreignKey name="fk_order_user" action="ADD"
                columns="user_id" refTable="nor_user" refColumns="id"
                onDelete="RESTRICT" onUpdate="CASCADE"/>
  </table>
</changeUnit>
